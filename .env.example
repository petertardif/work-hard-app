# Copy to `.env` and fill in from your Supabase project:
#   Dashboard → Project Settings → Data API  (URL)
#   Dashboard → Project Settings → API Keys  (anon / publishable key)
#
# EXPO_PUBLIC_ variables are inlined into the JS bundle at build time, so only
# ever put the ANON key here — never the service-role key. The anon key is safe
# to ship because row level security is what actually guards the data.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
