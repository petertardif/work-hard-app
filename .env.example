# Copy this file to `.env` and fill in the two values from your Supabase project.
#
# Where to find them:
#   Dashboard → your project → Connect (top bar)   ← easiest, shows both at once
#   or Dashboard → Settings → Data API             (Project URL)
#      Dashboard → Settings → API Keys             (Publishable key)
#
# Supabase is replacing the old `anon` key with a "publishable" key and will
# retire the old one by the end of 2026. A project created now shows the new
# kind. Either works here — paste whichever your dashboard gives you.
#
#   new:    sb_publishable_xxxxxxxxxxxxxxxxx      (short)
#   legacy: eyJhbGciOiJIUzI1NiIsInR5cCI6...       (very long, three dots)
#
# The key is also read from EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY or
# EXPO_PUBLIC_SUPABASE_ANON_KEY if you already have it under one of those names.
#
# NEVER put the secret / service_role key here. EXPO_PUBLIC_ variables are
# inlined into the shipped app bundle and anyone can read them out. The
# publishable key is safe to ship — row level security is what guards the data.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_your_key_here
